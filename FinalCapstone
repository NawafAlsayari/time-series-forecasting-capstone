        "print(f\"feature rows after the 28-day lag/rolling warm-up: {len(train_feats)} \"\n",
        "      f\"(lost {len(train) - len(train_feats)} warm-up rows)\")\n",
        "train_feats[[\"y\"] + FEATURE_COLS].head()"
